      <aliases enabled='yes' />
      <column caption='Average Risk Score' datatype='real' name='[Calculation_0255090729598976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [label] = 1 THEN [readmission_risk_score] END)' />
      </column>
      <column caption='Month Number' datatype='integer' name='[Calculation_0515950367584257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;,[admission_date])' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_0515950367760386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[admission_date])' />
      </column>
      <column caption='Current Month Rate' datatype='real' name='[Calculation_0515950371024901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(DATEPART(&apos;month&apos;,[admission_date])) = 12&#13;&#10;THEN&#13;&#10;SUM([label]) / COUNT([patient_id])&#13;&#10;END' />
      </column>
      <column caption='Previous Month Rate' datatype='real' name='[Calculation_0515950371561478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN(DATEPART(&apos;month&apos;,[admission_date])) = 11&#13;&#10;THEN&#13;&#10;SUM([label]) / COUNT([patient_id])&#13;&#10;END' />
      </column>
      <column caption='Delta' datatype='real' name='[Calculation_0515950372618249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM(&#13;&#10;IF DATEPART(&apos;month&apos;,[admission_date]) = 12&#13;&#10;THEN [label]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;&#13;&#10;COUNT(&#13;&#10;IF DATEPART(&apos;month&apos;,[admission_date]) = 12&#13;&#10;THEN [patient_id]&#13;&#10;END&#13;&#10;)&#13;&#10;&#13;&#10;)&#13;&#10;&#13;&#10;-&#13;&#10;&#13;&#10;(&#13;&#10;&#13;&#10;SUM(&#13;&#10;IF DATEPART(&apos;month&apos;,[admission_date]) = 11&#13;&#10;THEN [label]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;&#13;&#10;COUNT(&#13;&#10;IF DATEPART(&apos;month&apos;,[admission_date]) = 11&#13;&#10;THEN [patient_id]&#13;&#10;END&#13;&#10;)&#13;&#10;&#13;&#10;)' />
      </column>
      <column caption='Arrow Indicator' datatype='string' name='[Calculation_0515950377680906]' role='measure' type='nominal'>

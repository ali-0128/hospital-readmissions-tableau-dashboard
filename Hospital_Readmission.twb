      </column>
      <column caption='Final KPI' datatype='string' name='[Calculation_0515950377897995]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_0711937510887424]*100,1))&#13;&#10;+&#13;&#10;&quot;% &quot;&#13;&#10;+&#13;&#10;[Calculation_0515950377680906]&#13;&#10;+&#13;&#10;&quot; &quot;&#13;&#10;+&#13;&#10;STR(ABS(ROUND([Calculation_0515950372618249]*100,1)))&#13;&#10;+&#13;&#10;&quot;% vs previous month&quot;' />
